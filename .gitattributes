# Shell fixtures and launchers must stay runnable in Linux source archives,
# including archives created on Windows with core.autocrlf enabled.
*.sh text eol=lf
# Batch launchers must keep CRLF endings on Windows checkouts (cmd.exe label and goto handling).
launchers/*.bat text eol=crlf
packaging/**/*.bat text eol=crlf
packaging/config.txt text eol=lf
scripts/pearl_sustained_public_*.py text eol=lf
scripts/pearl_sustained_telemetry_smoke.py text eol=lf
tests/test_pearl_sustained_public_*.py text eol=lf
tests/fixtures/dashboard_*.txt text eol=lf
docs/sustained-public-wrapper-cpu-tests-20260905.txt text eol=lf

# Preserve exact upstream notice bytes in source archives.
LICENSES/NVIDIA-CUDA-13.1.1/*.txt -text
# Exact optional dependency notices, including upstream Markdown trailing spaces.
LICENSES/curl-8.23.0.txt -text
LICENSES/c-ares-1.34.9.txt -text whitespace=-blank-at-eol
