{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private pool-security declarations v1 (no live activation)",
  "description": "Independent user slots and donation declaration. Saving starts no networking; requested TLS currently refuses ordinary startup. No wallets, credentials, private trust materials or live connection state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "user_pools", "donation"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "user_pools": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/rule"}},
    "donation": {"$ref": "#/$defs/rule"}
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "tls_url", "plaintext_url", "plaintext_consent"],
      "properties": {
        "mode": {"enum": ["unchanged", "strict_tls", "prefer_tls"]},
        "tls_url": {"type": "string", "maxLength": 300, "pattern": "^(?:|stratum\\+ssl://(?=[^:]{1,253}:)(?=[a-z0-9.-]*[a-z-])[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*:(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))$(?![\\s\\S])"},
        "plaintext_url": {"type": "string", "maxLength": 300, "pattern": "^(?:|stratum\\+tcp://(?=[^:]{1,253}:)(?=[a-z0-9.-]*[a-z-])[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*:(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))$(?![\\s\\S])"},
        "plaintext_consent": {"type": "boolean", "default": false}
      },
      "if": {"properties": {"plaintext_consent": {"const": true}}},
      "then": {"properties": {"mode": {"const": "prefer_tls"}, "tls_url": {"minLength": 1}, "plaintext_url": {"minLength": 1}}},
      "else": {
        "if": {"properties": {"mode": {"const": "unchanged"}}},
        "then": {},
        "else": {"properties": {"tls_url": {"minLength": 1}}}
      }
    }
  }
}
