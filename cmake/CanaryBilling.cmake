# Optional fixture billing helpers and background recovery. Linking does not enable a native runtime or source adapter.
add_library(canary_billing STATIC "${CMAKE_SOURCE_DIR}/src/product/billing_ledger.cpp" "${CMAKE_SOURCE_DIR}/src/product/billing_recovery.cpp" "${CMAKE_SOURCE_DIR}/src/product/billing_codec.cpp" "${CMAKE_SOURCE_DIR}/src/product/billing_query_process.cpp" "${CMAKE_SOURCE_DIR}/src/product/billing_retry_process.cpp" "${CMAKE_SOURCE_DIR}/src/product/billing_input_process.cpp" "${CMAKE_SOURCE_DIR}/src/product/billing_input_store.cpp" "${CMAKE_SOURCE_DIR}/src/product/billing_input_query.cpp")
target_compile_features(canary_billing PUBLIC cxx_std_17)
target_sources(canary_billing PRIVATE "${CMAKE_SOURCE_DIR}/src/product/billing_owner.cpp")
target_sources(canary_billing PRIVATE "${CMAKE_SOURCE_DIR}/src/product/billing_compute_owner.cpp")
target_include_directories(canary_billing PUBLIC "${CMAKE_SOURCE_DIR}/src")
target_link_libraries(canary_billing PUBLIC canary_economics canary_energy_history PRIVATE ${CMAKE_DL_LIBS})
if(MSVC)
  target_compile_definitions(canary_billing PRIVATE NOMINMAX)
  target_compile_options(canary_billing PRIVATE /W3 /utf-8)
else()
  target_compile_options(canary_billing PRIVATE -Wall -Wextra -Werror)
endif()
add_executable(canary_billing_query_worker "${CMAKE_SOURCE_DIR}/src/product/billing_query_worker.cpp")
target_link_libraries(canary_billing_query_worker PRIVATE canary_billing)
add_executable(canary_billing_retry_worker "${CMAKE_SOURCE_DIR}/src/product/billing_retry_worker.cpp")
target_link_libraries(canary_billing_retry_worker PRIVATE canary_billing)
add_executable(canary_billing_input_worker "${CMAKE_SOURCE_DIR}/src/product/billing_input_worker.cpp")
target_link_libraries(canary_billing_input_worker PRIVATE canary_billing)
add_executable(canary_billing_input_query_worker "${CMAKE_SOURCE_DIR}/src/product/billing_input_query_worker.cpp")
target_link_libraries(canary_billing_input_query_worker PRIVATE canary_billing)
