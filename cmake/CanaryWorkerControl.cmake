# Private protocol, paired native transport and development-only child admission.
option(CANARY_ENABLE_WORKER_CONTROL_RUNTIME "Build opt-in inherited worker control entry point (development)" OFF)
function(canary_enable_worker_control target)
  target_compile_definitions(${target} PRIVATE CANARY_ENABLE_WORKER_CONTROL_RUNTIME=1)
  target_link_libraries(${target} PRIVATE canary_worker_process)
endfunction()
add_library(canary_worker_control STATIC "${CMAKE_SOURCE_DIR}/src/product/worker_control.cpp")
target_compile_features(canary_worker_control PUBLIC cxx_std_17)
target_include_directories(canary_worker_control PUBLIC "${CMAKE_SOURCE_DIR}/src")
target_link_libraries(canary_worker_control PUBLIC Threads::Threads)
if(MSVC)
  target_compile_options(canary_worker_control PRIVATE /W3 /utf-8)
else()
  target_compile_options(canary_worker_control PRIVATE -Wall -Wextra -Werror)
endif()
add_library(canary_game_workers STATIC "${CMAKE_SOURCE_DIR}/src/product/game_worker_session.cpp")
target_compile_features(canary_game_workers PUBLIC cxx_std_17)
target_include_directories(canary_game_workers PUBLIC "${CMAKE_SOURCE_DIR}/src")
target_link_libraries(canary_game_workers PUBLIC canary_game_detection canary_worker_process canary_worker_identity canary_optimizer)
if(MSVC)
  target_compile_definitions(canary_game_workers PRIVATE NOMINMAX)
  target_compile_options(canary_game_workers PRIVATE /W3 /utf-8)
else()
  target_compile_options(canary_game_workers PRIVATE -Wall -Wextra -Werror)
endif()
add_library(canary_worker_identity STATIC "${CMAKE_SOURCE_DIR}/src/product/worker_identity.cpp")
target_compile_features(canary_worker_identity PUBLIC cxx_std_17)
target_include_directories(canary_worker_identity PUBLIC "${CMAKE_SOURCE_DIR}/src")
target_link_libraries(canary_worker_identity PUBLIC canary_local_tasks)
add_executable(canary_worker_identity_worker "${CMAKE_SOURCE_DIR}/src/product/worker_identity_worker.cpp" "${CMAKE_SOURCE_DIR}/src/product/private_entropy.cpp")
target_link_libraries(canary_worker_identity_worker PRIVATE canary_worker_identity $<$<PLATFORM_ID:Windows>:bcrypt>)
foreach(target canary_worker_identity canary_worker_identity_worker)
  if(MSVC)
    target_compile_options(${target} PRIVATE /W3 /utf-8)
  else()
    target_compile_options(${target} PRIVATE -Wall -Wextra -Werror)
  endif()
endforeach()
add_library(canary_worker_process STATIC "${CMAKE_SOURCE_DIR}/src/product/worker_process.cpp" "${CMAKE_SOURCE_DIR}/src/product/worker_process_owner.cpp")
target_compile_features(canary_worker_process PUBLIC cxx_std_17)
target_include_directories(canary_worker_process PUBLIC "${CMAKE_SOURCE_DIR}/src")
target_link_libraries(canary_worker_process PUBLIC canary_worker_control)
if(MSVC)
  target_compile_definitions(canary_worker_process PRIVATE NOMINMAX)
  target_compile_options(canary_worker_process PRIVATE /W3 /utf-8)
else()
  target_compile_options(canary_worker_process PRIVATE -Wall -Wextra -Werror)
endif()
