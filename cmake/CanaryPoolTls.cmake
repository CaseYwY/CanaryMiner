# Explicit development backend only. No configure-time downloads, live endpoints or runtime activation.
option(CANARY_ENABLE_POOL_TLS_OPENSSL "Build development OpenSSL native pool TLS steps (Linux only)" OFF)
option(CANARY_ENABLE_POOL_TLS_PRIVATE_TRUST "Build development offline Windows private-chain inspection" OFF)
option(CANARY_ENABLE_POOL_TLS_SCHANNEL "Build development Windows Schannel record steps" OFF)
add_library(canary_pool_tls STATIC "${CMAKE_SOURCE_DIR}/src/core/pearl_tls_stream.cpp" "${CMAKE_SOURCE_DIR}/src/core/pearl_tls_openssl.cpp" "${CMAKE_SOURCE_DIR}/src/core/pearl_tls_schannel.cpp" "${CMAKE_SOURCE_DIR}/src/core/pearl_tls_private_trust.cpp")
target_compile_features(canary_pool_tls PUBLIC cxx_std_17)
target_include_directories(canary_pool_tls PUBLIC "${CMAKE_SOURCE_DIR}/src")
if(MSVC)
  target_compile_definitions(canary_pool_tls PRIVATE NOMINMAX)
  target_compile_options(canary_pool_tls PRIVATE /W3 /utf-8)
else()
  target_compile_options(canary_pool_tls PRIVATE -Wall -Wextra -Werror)
endif()
if(CANARY_ENABLE_POOL_TLS_PRIVATE_TRUST)
  if(NOT WIN32)
    message(FATAL_ERROR "Private-chain inspection is Windows-only; do not substitute a different native policy")
  endif()
  target_compile_definitions(canary_pool_tls PRIVATE CANARY_POOL_TLS_PRIVATE_TRUST_WINDOWS=1)
  target_link_libraries(canary_pool_tls PRIVATE crypt32)
endif()
if(CANARY_ENABLE_POOL_TLS_SCHANNEL)
  if(NOT WIN32)
    message(FATAL_ERROR "Schannel record steps require Windows native trust")
  endif()
  target_compile_definitions(canary_pool_tls PRIVATE CANARY_POOL_TLS_SCHANNEL=1 _WIN32_WINNT=0x0A00 NTDDI_VERSION=0x0A000006)
  target_link_libraries(canary_pool_tls PRIVATE secur32 crypt32)
endif()
if(CANARY_ENABLE_POOL_TLS_OPENSSL)
  if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
    message(FATAL_ERROR "This development backend is Linux-only; do not substitute it for Windows native trust")
  endif()
  find_package(OpenSSL 3.5 REQUIRED)
  target_compile_definitions(canary_pool_tls PRIVATE CANARY_POOL_TLS_OPENSSL=1)
  target_link_libraries(canary_pool_tls PRIVATE OpenSSL::SSL OpenSSL::Crypto)
endif()
