# Explicit development backend only. No configure-time downloads, live endpoints or runtime activation.
option(CANARY_ENABLE_POOL_TLS_OPENSSL "Build development OpenSSL native pool TLS steps (Linux only)" OFF)
option(CANARY_ENABLE_POOL_TLS_PRIVATE_TRUST "Build development offline Windows private-chain inspection" OFF)
option(CANARY_ENABLE_POOL_TLS_SCHANNEL "Build development Windows Schannel record steps" OFF)
add_library(canary_pool_tls STATIC "${CMAKE_SOURCE_DIR}/src/core/pearl_tls_stream.cpp" "${CMAKE_SOURCE_DIR}/src/core/pearl_tls_openssl.cpp" "${CMAKE_SOURCE_DIR}/src/core/pearl_tls_schannel.cpp" "${CMAKE_SOURCE_DIR}/src/core/pearl_tls_private_trust.cpp")
target_compile_features(canary_pool_tls PUBLIC cxx_std_17)
target_include_directories(canary_pool_tls PUBLIC "${CMAKE_SOURCE_DIR}/src")
if(MSVC)
  target_compile_definitions(canary_pool_tls PRIVATE NOMINMAX)
  target_compile_options(canary_pool_tls PRIVATE /W3 /utf-8)
else()
  target_compile_options(canary_pool_tls PRIVATE -Wall -Wextra -Werror)
endif()
add_library(canary_pool_tls_check STATIC "${CMAKE_SOURCE_DIR}/src/product/pool_tls_check.cpp" "${CMAKE_SOURCE_DIR}/src/product/pool_tls_rpc.cpp")
target_compile_features(canary_pool_tls_check PUBLIC cxx_std_17)
target_include_directories(canary_pool_tls_check PUBLIC "${CMAKE_SOURCE_DIR}/src")
target_link_libraries(canary_pool_tls_check PRIVATE canary_local_tasks)
add_library(canary_duplex_tasks STATIC "${CMAKE_SOURCE_DIR}/src/product/duplex_task_process.cpp")
target_compile_features(canary_duplex_tasks PUBLIC cxx_std_17)
target_include_directories(canary_duplex_tasks PUBLIC "${CMAKE_SOURCE_DIR}/src")
target_link_libraries(canary_duplex_tasks PRIVATE canary_local_tasks)
add_library(canary_pool_tls_process STATIC "${CMAKE_SOURCE_DIR}/src/product/pool_tls_process_transport.cpp")
target_link_libraries(canary_pool_tls_process PUBLIC canary_pool_tls_check PRIVATE canary_duplex_tasks)
add_library(canary_pool_tls_service STATIC "${CMAKE_SOURCE_DIR}/src/product/pool_tls_stream_service.cpp")
target_link_libraries(canary_pool_tls_service PUBLIC canary_pool_tls_check PRIVATE canary_duplex_tasks)
add_library(canary_pool_tls_check_native STATIC "${CMAKE_SOURCE_DIR}/src/product/pool_tls_check_native.cpp")
target_link_libraries(canary_pool_tls_check_native PUBLIC canary_pool_tls_check PRIVATE canary_pool_tls)
foreach(target canary_pool_tls_check canary_pool_tls_check_native canary_duplex_tasks canary_pool_tls_process canary_pool_tls_service)
  if(MSVC)
    target_compile_definitions(${target} PRIVATE NOMINMAX)
    target_compile_options(${target} PRIVATE /W3 /utf-8)
  else()
    target_compile_options(${target} PRIVATE -Wall -Wextra -Werror)
  endif()
endforeach()
option(CANARY_ENABLE_POOL_TLS_CHECK "Build explicit one-shot native DNS/connect/TLS inspection helper (no mining)" OFF)
if(CANARY_ENABLE_POOL_TLS_CHECK)
  if(NOT CANARY_ENABLE_POOL_TLS_OPENSSL AND NOT CANARY_ENABLE_POOL_TLS_SCHANNEL)
    message(FATAL_ERROR "Native TLS inspection requires an explicit platform TLS engine")
  endif()
  target_compile_definitions(canary_pool_tls_check_native PRIVATE CANARY_POOL_TLS_CHECK=1)
  add_executable(canary_pool_tls_check_worker "${CMAKE_SOURCE_DIR}/src/product/pool_tls_check_worker.cpp")
  target_link_libraries(canary_pool_tls_check_worker PRIVATE canary_pool_tls_check_native)
  if(MSVC)
    target_compile_definitions(canary_pool_tls_check_worker PRIVATE NOMINMAX)
    target_compile_options(canary_pool_tls_check_worker PRIVATE /W3 /utf-8)
  else()
    target_compile_options(canary_pool_tls_check_worker PRIVATE -Wall -Wextra -Werror)
  endif()
endif()
option(CANARY_ENABLE_POOL_TLS_STREAM "Build explicit development persistent TLS helper (no ordinary factory)" OFF)
if(CANARY_ENABLE_POOL_TLS_STREAM)
  if(NOT CANARY_ENABLE_POOL_TLS_CHECK)
    message(FATAL_ERROR "Persistent TLS helper requires the explicit native connection capability")
  endif()
  add_executable(canary_pool_tls_stream_worker "${CMAKE_SOURCE_DIR}/src/product/pool_tls_stream_worker.cpp")
  target_link_libraries(canary_pool_tls_stream_worker PRIVATE canary_pool_tls_service canary_pool_tls_check_native)
  if(MSVC)
    target_compile_definitions(canary_pool_tls_stream_worker PRIVATE NOMINMAX)
    target_compile_options(canary_pool_tls_stream_worker PRIVATE /W3 /utf-8)
  else()
    target_compile_options(canary_pool_tls_stream_worker PRIVATE -Wall -Wextra -Werror)
  endif()
endif()
if(CANARY_ENABLE_POOL_TLS_PRIVATE_TRUST)
  if(NOT WIN32)
    message(FATAL_ERROR "Private-chain inspection is Windows-only; do not substitute a different native policy")
  endif()
  target_compile_definitions(canary_pool_tls PRIVATE CANARY_POOL_TLS_PRIVATE_TRUST_WINDOWS=1)
  target_link_libraries(canary_pool_tls PRIVATE crypt32)
endif()
if(CANARY_ENABLE_POOL_TLS_SCHANNEL)
  if(NOT WIN32)
    message(FATAL_ERROR "Schannel record steps require Windows native trust")
  endif()
  target_compile_definitions(canary_pool_tls PRIVATE CANARY_POOL_TLS_SCHANNEL=1 _WIN32_WINNT=0x0A00 NTDDI_VERSION=0x0A000006)
  target_link_libraries(canary_pool_tls PRIVATE secur32 crypt32)
endif()
if(CANARY_ENABLE_POOL_TLS_OPENSSL)
  if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
    message(FATAL_ERROR "This development backend is Linux-only; do not substitute it for Windows native trust")
  endif()
  find_package(OpenSSL 3.5 REQUIRED)
  target_compile_definitions(canary_pool_tls PRIVATE CANARY_POOL_TLS_OPENSSL=1)
  target_link_libraries(canary_pool_tls PRIVATE OpenSSL::SSL OpenSSL::Crypto)
endif()
