# Explicitly supplied maintained Unicode backend; no download, OS ICU guessing or ordinary UI activation.
option(CANARY_ENABLE_TERMINAL_ICU "Enable development ICU grapheme/cell/bidi layout" OFF)
add_library(canary_terminal_text STATIC "${CMAKE_SOURCE_DIR}/src/product/terminal_text.cpp")
target_include_directories(canary_terminal_text PUBLIC "${CMAKE_SOURCE_DIR}/src")
target_compile_features(canary_terminal_text PUBLIC cxx_std_17)
if(MSVC)
  target_compile_definitions(canary_terminal_text PRIVATE NOMINMAX)
  target_compile_options(canary_terminal_text PRIVATE /W3 /utf-8)
else()
  target_compile_options(canary_terminal_text PRIVATE -Wall -Wextra -Werror)
endif()
if(CANARY_ENABLE_TERMINAL_ICU)
  find_package(ICU 79.1 REQUIRED COMPONENTS uc i18n data)
  target_compile_definitions(canary_terminal_text PRIVATE CANARY_TERMINAL_ICU=1)
  target_link_libraries(canary_terminal_text PRIVATE ICU::i18n ICU::uc ICU::data)
endif()
