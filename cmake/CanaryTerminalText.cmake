# Explicitly supplied maintained Unicode backend; no download, OS ICU guessing or ordinary UI activation.
option(CANARY_ENABLE_TERMINAL_ICU "Enable development ICU grapheme/cell/bidi layout" OFF)
add_library(canary_terminal_text STATIC "${CMAKE_SOURCE_DIR}/src/product/terminal_text.cpp" "${CMAKE_SOURCE_DIR}/src/product/terminal_segments.cpp")
add_library(canary_localized_format STATIC "${CMAKE_SOURCE_DIR}/src/product/localized_format.cpp")
target_link_libraries(canary_localized_format PRIVATE canary_market)
foreach(target canary_terminal_text canary_localized_format)
  target_include_directories(${target} PUBLIC "${CMAKE_SOURCE_DIR}/src")
  target_compile_features(${target} PUBLIC cxx_std_17)
  if(MSVC)
    target_compile_definitions(${target} PRIVATE NOMINMAX)
    target_compile_options(${target} PRIVATE /W3 /utf-8)
  else()
    target_compile_options(${target} PRIVATE -Wall -Wextra -Werror)
  endif()
endforeach()
add_library(canary_terminal_number STATIC "${CMAKE_SOURCE_DIR}/src/product/terminal_number.cpp")
add_library(canary_terminal_message STATIC "${CMAKE_SOURCE_DIR}/src/product/terminal_message.cpp")
target_include_directories(canary_terminal_message PUBLIC "${CMAKE_SOURCE_DIR}/src")
target_compile_features(canary_terminal_message PUBLIC cxx_std_17)
target_link_libraries(canary_terminal_message PRIVATE canary_terminal_text)
if(MSVC)
  target_compile_definitions(canary_terminal_message PRIVATE NOMINMAX)
  target_compile_options(canary_terminal_message PRIVATE /W3 /utf-8)
else()
  target_compile_options(canary_terminal_message PRIVATE -Wall -Wextra -Werror)
endif()
target_include_directories(canary_terminal_number PUBLIC "${CMAKE_SOURCE_DIR}/src")
target_compile_features(canary_terminal_number PUBLIC cxx_std_17)
target_link_libraries(canary_terminal_number PRIVATE canary_terminal_text canary_localized_format)
if(MSVC)
  target_compile_definitions(canary_terminal_number PRIVATE NOMINMAX)
  target_compile_options(canary_terminal_number PRIVATE /W3 /utf-8)
else()
  target_compile_options(canary_terminal_number PRIVATE -Wall -Wextra -Werror)
endif()
if(CANARY_ENABLE_TERMINAL_ICU)
  find_package(ICU 79.1 REQUIRED COMPONENTS uc i18n data)
  foreach(target canary_terminal_text canary_localized_format)
    target_compile_definitions(${target} PRIVATE CANARY_TERMINAL_ICU=1)
    target_link_libraries(${target} PRIVATE ICU::i18n ICU::uc ICU::data)
  endforeach()
endif()
