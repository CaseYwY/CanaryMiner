# Private helper foundation only. Linking/building does not activate a source, settings callback or ordinary runtime owner.
add_library(canary_preferences_protocol STATIC "${CMAKE_SOURCE_DIR}/src/product/preferences_protocol.cpp")
target_compile_features(canary_preferences_protocol PUBLIC cxx_std_17)
target_include_directories(canary_preferences_protocol PUBLIC "${CMAKE_SOURCE_DIR}/src")
add_library(canary_preferences_service STATIC "${CMAKE_SOURCE_DIR}/src/product/preferences_service.cpp")
target_link_libraries(canary_preferences_service PUBLIC canary_preferences_protocol PRIVATE canary_economics canary_local_tasks)
add_library(canary_preferences_documents STATIC "${CMAKE_SOURCE_DIR}/src/product/preferences_document.cpp")
target_link_libraries(canary_preferences_documents PUBLIC canary_preferences_protocol PRIVATE canary_economics)
add_library(canary_preferences_owner STATIC "${CMAKE_SOURCE_DIR}/src/product/preferences_owner.cpp")
target_link_libraries(canary_preferences_owner PUBLIC canary_preferences_protocol PRIVATE canary_preferences_documents canary_duplex_tasks Threads::Threads)
add_executable(canary_preferences_worker "${CMAKE_SOURCE_DIR}/src/product/preferences_worker.cpp")
target_link_libraries(canary_preferences_worker PRIVATE canary_preferences_service canary_duplex_tasks Threads::Threads)
foreach(target canary_preferences_protocol canary_preferences_service canary_preferences_documents canary_preferences_owner canary_preferences_worker)
  if(MSVC)
    target_compile_definitions(${target} PRIVATE NOMINMAX)
    target_compile_options(${target} PRIVATE /W3 /utf-8 /wd4996)
  else()
    target_compile_options(${target} PRIVATE -Wall -Wextra -Werror)
  endif()
endforeach()
