# Native exact billing/time/energy core. No timezone or market network access at configure/runtime.
option(CANARY_ENABLE_NAMED_TZDB "Enable reviewed app-private date-tz / IANA timezone data" OFF)
add_library(canary_economics STATIC
  "${CMAKE_SOURCE_DIR}/src/product/civil_time.cpp"
  "${CMAKE_SOURCE_DIR}/src/product/electricity.cpp"
  "${CMAKE_SOURCE_DIR}/src/product/tariff_declaration.cpp"
  "${CMAKE_SOURCE_DIR}/src/product/energy_owner.cpp")
target_compile_features(canary_economics PUBLIC cxx_std_17)
target_include_directories(canary_economics PUBLIC "${CMAKE_SOURCE_DIR}/src")
target_link_libraries(canary_economics PUBLIC canary_market)
find_package(Threads REQUIRED)
target_link_libraries(canary_economics PRIVATE Threads::Threads)
if(MSVC)
  target_compile_definitions(canary_economics PRIVATE NOMINMAX)
  target_compile_options(canary_economics PRIVATE /W3 /utf-8)
else()
  target_compile_options(canary_economics PRIVATE -Wall -Wextra -Werror=format)
endif()
if(CANARY_ENABLE_NAMED_TZDB)
  # Official v3.0.5 source still declares CMake package version 3.0.4; source provenance is a separate release gate.
  find_package(date 3.0.4 CONFIG REQUIRED)
  include(CheckCXXSourceCompiles)
  include(CMakePushCheckState)
  block(SCOPE_FOR VARIABLES)
    set(CMAKE_TRY_COMPILE_CONFIGURATION Release)
    cmake_push_check_state(RESET)
    if(MSVC)
      set(CMAKE_REQUIRED_FLAGS "/std:c++17")
    else()
      set(CMAKE_REQUIRED_FLAGS "-std=c++17")
    endif()
    set(CMAKE_REQUIRED_LIBRARIES date::date-tz)
    unset(CANARY_DATE_MANUAL_LINKS CACHE)
    unset(CANARY_DATE_REMOTE_LINKS CACHE)
    if(WIN32)
      list(APPEND CMAKE_REQUIRED_LIBRARIES shell32 ole32)
    endif()
    check_cxx_source_compiles("#define HAS_REMOTE_API 0\n#define AUTO_DOWNLOAD 0\n#include <date/tz.h>\n#if USE_OS_TZDB\n#error app private text database required\n#endif\nint main(){date::set_install(\"unused-offline-link-probe\"); return date::get_tzdb().version.empty();}" CANARY_DATE_MANUAL_LINKS)
    if(NOT CANARY_DATE_MANUAL_LINKS)
      message(FATAL_ERROR "date-tz must provide the app-private text-database interface")
    endif()
    check_cxx_source_compiles("#define HAS_REMOTE_API 1\n#define AUTO_DOWNLOAD 0\n#include <date/tz.h>\nint main(){return date::remote_version().empty();}" CANARY_DATE_REMOTE_LINKS)
    if(CANARY_DATE_REMOTE_LINKS)
      message(FATAL_ERROR "date-tz remote API must be compiled out (MANUAL_TZ_DB=ON)")
    endif()
    cmake_pop_check_state()
  endblock()
  target_compile_definitions(canary_economics PRIVATE CANARY_NAMED_TZDB=1 HAS_REMOTE_API=0 AUTO_DOWNLOAD=0)
  target_link_libraries(canary_economics PRIVATE date::date-tz)
  if(WIN32)
    target_link_libraries(canary_economics PRIVATE shell32 ole32)
  endif()
endif()
