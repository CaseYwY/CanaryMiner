# No automatic dependency download or configure-time network access. Supply reviewed CURL/c-ares packages explicitly.
option(CANARY_ENABLE_PUBLIC_HTTPS "Build optional verified public JSON HTTPS transport (libcurl + c-ares)" OFF)

add_library(canary_public_https STATIC "${CMAKE_SOURCE_DIR}/src/product/public_https.cpp" "${CMAKE_SOURCE_DIR}/src/product/public_json_process.cpp")
target_compile_features(canary_public_https PUBLIC cxx_std_17)
target_include_directories(canary_public_https PUBLIC "${CMAKE_SOURCE_DIR}/src")
if(MSVC)
  target_compile_definitions(canary_public_https PRIVATE NOMINMAX)
  target_compile_options(canary_public_https PRIVATE /W3 /utf-8)
else()
  target_compile_options(canary_public_https PRIVATE -Wall -Wextra -Werror=format)
endif()
if(CANARY_ENABLE_PUBLIC_HTTPS)
  find_package(CURL 8.12 REQUIRED)
  target_compile_definitions(canary_public_https PRIVATE CANARY_PUBLIC_HTTPS=1)
  target_link_libraries(canary_public_https PRIVATE CURL::libcurl)
  add_executable(canary_public_json_worker "${CMAKE_SOURCE_DIR}/src/product/public_json_worker.cpp")
  target_link_libraries(canary_public_json_worker PRIVATE canary_public_https)
endif()
